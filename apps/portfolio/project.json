{
  "name": "portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/portfolio/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/portfolio-frontend",
        "browser": "apps/portfolio/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/portfolio/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/portfolio/public"
          },
          {
            "glob": "**/*",
            "input": "apps/portfolio/src/app/lebenslauf/data/assets",
            "output": "data/assets"
          },
          {
            "glob": "**/*",
            "input": "apps/portfolio/src/app/portfolio/data/assets",
            "output": "data/assets"
          },
          {
            "glob": "**/*",
            "input": "apps/portfolio/src/app/portfolio/data/texte",
            "output": "data/texte"
          }
        ],
        "styles": [
          "apps/portfolio/src/styles.scss",
          "@angular/material/prebuilt-themes/azure-blue.css",
          "./node_modules/ngx-lightbox/lightbox.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "portfolio:build:production"
        },
        "development": {
          "buildTarget": "portfolio:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "portfolio:build"
      }
    },
    "test": {
      "executor": "@nx/vite:vitest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "polyfills": ["zone.js", "zone.js/testing"],
        "tsConfig": "tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/portfolio/public"
          },
          {
            "glob": "**/*",
            "input": "src/app/lebenslauf/data/assets",
            "output": "apps/portfolio/data/assets"
          },
          {
            "glob": "**/*",
            "input": "src/app/portfolio/data/assets",
            "output": "apps/portfolio/data/assets"
          },
          {
            "glob": "**/*",
            "input": "src/app/portfolio/data/texte",
            "output": "apps/portfolio/data/texte"
          }
        ],
        "styles": [
          "apps/portfolio/src/styles.scss",
          "@angular/material/prebuilt-themes/azure-blue.css",
          "./node_modules/ngx-lightbox/lightbox.css"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "portfolio:build",
        "port": 4200,
        "spa": true
      }
    }
  }
}
